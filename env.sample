# Google API key with the Google Drive API enabled. Only used on the server.
GOOGLE_API_KEY=

# How close a face must be to count as a match (0 to 1, lower is stricter). Defaults to 0.5.
NEXT_PUBLIC_FACE_MATCHER_THRESHOLD=

# Minimum confidence for a face to be detected in a photo (0 to 1). Defaults to 0.3.
NEXT_PUBLIC_MIN_CONFIDENCE=
